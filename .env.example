# AI Study Workspace Environment Variables
# Copy to .env.local to customize

# Gemini API Key (for context-aware AI tutor streaming)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: YouTube Data API v3 (for dynamic video search and metadata)
YOUTUBE_API_KEY=

# Optional: Supabase for persistent cloud backend & auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
