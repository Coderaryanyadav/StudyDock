# StudyDock — Production Environment Configuration
# Copy this file to .env.local: cp .env.example .env.local

# ==========================================
# 1. GOOGLE GEMINI AI (Required for Production AI & Embeddings)
# Get your API key at: https://aistudio.google.com/app/apikey
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. SUPABASE POSTGRESQL & PGVECTOR (Required for Production Database, Auth & Vector RAG)
# Create a free project at: https://supabase.com
# Execute database/schema.sql in the Supabase SQL Editor
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# 3. YOUTUBE API (Optional)
# For automated lecture search and metadata synchronization
# ==========================================
YOUTUBE_API_KEY=your_youtube_api_key_here

# ==========================================
# 4. APP CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional Demo Mode Quarantine (Leave false for normal authenticated production)
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
